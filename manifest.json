{
  "manifest_version": 3,
  "name": "SiteWhisper",
  "version": "2.0",
  "description": "Reads any webpage and acts on it for you — fill forms, click through flows, look things up. Bring your own API key.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.cember.in/*"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
