{
  "manifest_version": 3,
  "name": "SiteWhisper",
  "version": "1.1",
  "description": "Chat with any webpage — AI reads the page content, finds relevant sections, and answers your questions using Claude, Gemini, or GPT.",

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "<all_urls>",
    "https://api.cember.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "side_panel": {
    "default_path": "popup/popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "options_page": "options/option.html"
}
